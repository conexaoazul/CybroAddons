#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "%d attachment"
msgstr "%d anexo"

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "%d attachments"
msgstr "%d anexos"

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Support ticket submission is not configured yet. Please use the WhatsApp button to contact Conexão Azul."
msgstr "O envio de chamados ainda não está configurado. Use o botão WhatsApp para falar com a Conexão Azul."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "The support URL must use HTTPS and a Conexão Azul domain."
msgstr "A URL de suporte deve usar HTTPS e um domínio da Conexão Azul."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Support ticket authentication is not configured yet. Please use the WhatsApp button to contact Conexão Azul."
msgstr "A autenticação dos chamados ainda não está configurada. Use o botão WhatsApp para falar com a Conexão Azul."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "You can attach at most %s files."
msgstr "Você pode anexar no máximo %s arquivos."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "\"%s\" can't be sent: only images (PNG, JPG, GIF, WEBP, BMP), PDF and Word documents can be attached."
msgstr "Não é possível enviar \"%s\": são aceitos apenas imagens (PNG, JPG, GIF, WEBP, BMP), PDF e documentos Word."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "\"%s\" is larger than 3 MB. Please reduce its size."
msgstr "\"%s\" ultrapassa 3 MB. Reduza o tamanho do arquivo."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Your attachments are too large. Please reduce their size and try again."
msgstr "Os anexos são muito grandes. Reduza o tamanho e tente novamente."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "The support service is having issues. Please try again in a few minutes."
msgstr "O serviço de suporte está indisponível no momento. Tente novamente em alguns minutos."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "The ticket submission was rejected. Please check your inputs and try again."
msgstr "O chamado foi recusado. Confira os dados e tente novamente."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Could not reach the support service. Please check your network and try again."
msgstr "Não foi possível acessar o suporte. Verifique sua conexão e tente novamente."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "The support service returned an unexpected response. Please try again later."
msgstr "O suporte retornou uma resposta inesperada. Tente novamente mais tarde."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Your Ticket Created Successfully"
msgstr "Chamado criado com sucesso"

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "Ticket Reference : %s"
msgstr "Número do chamado: %s"

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Save this reference to follow up with Conexão Azul."
msgstr "Guarde este número para acompanhar seu atendimento com a Conexão Azul."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
#, python-format
msgid "Track your ticket status here: %s"
msgstr "Acompanhe o status do chamado aqui: %s"

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "The support server rejected this request. Please update the Conexão Azul Support Assistant module to the latest version."
msgstr "O servidor de suporte recusou a solicitação. Atualize o módulo Assistente de Suporte Conexão Azul."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Too many support requests were sent recently. Please try again later."
msgstr "Muitas solicitações de suporte foram enviadas recentemente. Tente novamente mais tarde."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "One of your attachments is larger than 3 MB. Please reduce its size."
msgstr "Um dos anexos ultrapassa 3 MB. Reduza o tamanho do arquivo."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Only images (PNG, JPG, GIF, WEBP, BMP), PDF and Word documents can be attached."
msgstr "Só é possível anexar imagens (PNG, JPG, GIF, WEBP, BMP), PDF e documentos Word."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Please check the subject and the email address."
msgstr "Confira o assunto e o endereço de e-mail."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "The ticket submission did not go through. Please try again."
msgstr "O chamado não foi enviado. Tente novamente."

#. module: blue_support_client
#: code:addons/blue_support_client/wizard/client_support.py:0
msgid "Configure a valid support WhatsApp number."
msgstr "Configure um número de WhatsApp válido para o suporte."

